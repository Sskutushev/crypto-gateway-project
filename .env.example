# Copy to .env. Docker Compose reads it for the `workers` profile; the API
# binary reads the same names when run outside Compose.

# --- the two values the workers need -------------------------------------
# A TronGrid API key (free tier is enough for the Nile testnet): https://www.trongrid.io
TRONGRID_API_KEY=
# 32 random bytes, hex: `openssl rand -hex 32`. Signs every merchant webhook.
GATEWAY_WEBHOOK_MASTER_KEY=

# --- the rail scripts/seed-dev-rail.sql describes; the self-check pins it ---
# Replace the placeholder collector with a Nile address you control, in this
# file AND in scripts/seed-dev-rail.sql, before paying anything.
GATEWAY_EXPECTED_COLLECTORS=TAF8dttxK5iPKbvYC626aDBytrWANpLRXp
GATEWAY_EXPECTED_ASSETS=tron:nile:TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf
GATEWAY_CHAIN_ENVIRONMENT=testnet

# --- the API binary outside Compose ---------------------------------------
GATEWAY_DATABASE_URL=postgres://gateway:gateway@localhost:54329/gateway
GATEWAY_BIND_ADDRESS=0.0.0.0:8080
GATEWAY_RUN_MIGRATIONS=true
GATEWAY_MAX_CLOCK_SKEW_SECONDS=5
GATEWAY_EXPIRY_ENABLED=true
GATEWAY_EXPIRY_INTERVAL_SECONDS=30
GATEWAY_EXPIRY_BATCH_LIMIT=200
GATEWAY_EXPIRY_MAX_BATCHES_PER_TICK=10
RUST_LOG=gateway_api=info,gateway_http=info,gateway_scheduler=info,tower_http=info
