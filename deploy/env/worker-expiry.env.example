# worker-expiry: archives expired quotes and releases their amount leases.

GATEWAY_WORKER_ROLES=expiry
GATEWAY_DATABASE_URL=postgres://gateway_payment_prod:CHANGE_ME@db.example.internal:5432/gateway?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
GATEWAY_INSTANCE_NAME=worker-expiry

GATEWAY_CHAIN=tron
GATEWAY_NETWORK=mainnet
GATEWAY_CHAIN_ENVIRONMENT=mainnet
GATEWAY_EXPECTED_COLLECTORS=TCollectorAddressBase58CHANGE_ME
GATEWAY_EXPECTED_ASSETS=tron:mainnet:TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

GATEWAY_EXPIRY_INTERVAL_SECONDS=30
GATEWAY_EXPIRY_BATCH_LIMIT=200
GATEWAY_EXPIRY_MAX_BATCHES_PER_TICK=10

# Connections this process may hold open to PostgreSQL. The sum over every
# process must stay under the server's limit with headroom for operators.
GATEWAY_DB_MAX_CONNECTIONS=10
# Process metrics (latency histograms, pool shape) on their own port, with no
# key. Keep it off the public interface; unset it to serve none.
GATEWAY_METRICS_BIND_ADDRESS=127.0.0.1:9464

RUST_LOG=gateway_worker=info,gateway_scheduler=info
