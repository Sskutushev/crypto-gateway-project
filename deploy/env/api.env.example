# gateway-api. Copy to api.env; the file is read by Compose and never committed.

# The API's own login role (member of gateway_api). TLS to the database is
# not optional in production.
GATEWAY_DATABASE_URL=postgres://gateway_api_prod:CHANGE_ME@db.example.internal:5432/gateway?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
GATEWAY_BIND_ADDRESS=0.0.0.0:8080

# Migrations are applied by the migrator role in the release procedure, not by
# the API at start-up, and the quote expiry sweep is the worker-expiry
# service. The API role has neither privilege.
GATEWAY_RUN_MIGRATIONS=false
GATEWAY_EXPIRY_ENABLED=false

# Start-up self-check: the deployment the database must describe.
GATEWAY_CHAIN_ENVIRONMENT=mainnet
GATEWAY_EXPECTED_COLLECTORS=TCollectorAddressBase58CHANGE_ME
GATEWAY_EXPECTED_ASSETS=tron:mainnet:TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
GATEWAY_MAX_CLOCK_SKEW_SECONDS=5

# Request budgets per replica (0 disables one). Behind a reverse proxy, name
# the header it appends the client address to, or every client shares the
# proxy's address.
GATEWAY_RATE_LIMIT_MERCHANT_WRITES_PER_MINUTE=600
GATEWAY_RATE_LIMIT_MERCHANT_READS_PER_MINUTE=3000
GATEWAY_RATE_LIMIT_AUTH_FAILURES_PER_MINUTE=30
GATEWAY_RATE_LIMIT_CHECKOUT_READS_PER_MINUTE=600
GATEWAY_CLIENT_IP_HEADER=x-forwarded-for
# Reservations one receiving address may hold; unset for no cap.
# GATEWAY_MAX_OPEN_LEASES_PER_COLLECTOR=20000

# Manual honors allocating at least this many raw units need a second operator
# key to approve them. Leave unset to require two keys for every honor; set it
# (raw units, 6 decimals for USDT: 5000000 is 5 USDT) to let one person honor
# less. A value that is not a whole number stops the API.
# GATEWAY_MANUAL_HONOR_DUAL_CONTROL_MIN_RAW=5000000

# Connections this process may hold open to PostgreSQL. The sum over every
# process must stay under the server's limit with headroom for operators.
GATEWAY_DB_MAX_CONNECTIONS=20
# Process metrics (latency histograms, pool shape) on their own port, with no
# key. Keep it off the public interface; unset it to serve none.
GATEWAY_METRICS_BIND_ADDRESS=127.0.0.1:9464

RUST_LOG=gateway_api=info,gateway_http=info,gateway_scheduler=info,tower_http=info
