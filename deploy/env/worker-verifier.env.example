# worker-verifier: re-reads every claimed transfer through its own provider
# and makes it canonical only when independent groups and its re-read agree.
# Its provider must belong to a different provider group than any observer's.

GATEWAY_WORKER_ROLES=verifier
GATEWAY_DATABASE_URL=postgres://gateway_verifier_prod:CHANGE_ME@db.example.internal:5432/gateway?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
GATEWAY_INSTANCE_NAME=worker-verifier

GATEWAY_CHAIN=tron
GATEWAY_NETWORK=mainnet
GATEWAY_CHAIN_ENVIRONMENT=mainnet
GATEWAY_EXPECTED_COLLECTORS=TCollectorAddressBase58CHANGE_ME
GATEWAY_EXPECTED_ASSETS=tron:mainnet:TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# The chain_sources row the verifier's re-read is recorded under; its
# db_principal is the login role above.
GATEWAY_VERIFIER_SOURCE_KEY=verifier-mainnet
GATEWAY_VERIFIER_TRON_BASE_URL=https://tron-mainnet.provider-two.example
GATEWAY_VERIFIER_TRON_API_KEY=CHANGE_ME
GATEWAY_VERIFIER_TRON_API_KEY_HEADER=TRON-PRO-API-KEY
GATEWAY_VERIFIER_TRON_REQUEST_TIMEOUT_SECONDS=15

GATEWAY_VERIFIER_INTERVAL_SECONDS=5
GATEWAY_VERIFIER_BATCH_LIMIT=100
GATEWAY_VERIFIER_MAX_BATCHES_PER_TICK=5

RUST_LOG=gateway_worker=info,gateway_scheduler=info,gateway_tron=info
