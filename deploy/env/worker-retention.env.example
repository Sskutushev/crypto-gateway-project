# worker-retention: deletes old operational rows that no audit, reconciliation
# or evidence read still needs (docs/operator-runbook.md, "Retention"). It runs
# as gateway_retention, the only role that can delete, and only from webhook
# delivery attempts, chain observations and component health transitions.
#
# Every age is optional. A table without an age is never deleted from; with no
# age at all the role refuses to start. The shortest accepted age is 30 days.

GATEWAY_WORKER_ROLES=retention
GATEWAY_DATABASE_URL=postgres://gateway_retention_prod:CHANGE_ME@db.example.internal:5432/gateway?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
GATEWAY_INSTANCE_NAME=worker-retention

GATEWAY_CHAIN=tron
GATEWAY_NETWORK=mainnet
GATEWAY_CHAIN_ENVIRONMENT=mainnet
GATEWAY_EXPECTED_COLLECTORS=TCollectorAddressBase58CHANGE_ME
GATEWAY_EXPECTED_ASSETS=tron:mainnet:TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

GATEWAY_RETENTION_WEBHOOK_DELIVERIES_DAYS=180
GATEWAY_RETENTION_KEEP_DELIVERY_ATTEMPTS=3
GATEWAY_RETENTION_OBSERVATIONS_DAYS=400
GATEWAY_RETENTION_HEALTH_EVENTS_DAYS=400

GATEWAY_RETENTION_INTERVAL_SECONDS=3600
GATEWAY_RETENTION_BATCH_LIMIT=1000
GATEWAY_RETENTION_MAX_BATCHES_PER_TICK=10

# Connections this process may hold open to PostgreSQL. The sum over every
# process must stay under the server's limit with headroom for operators.
GATEWAY_DB_MAX_CONNECTIONS=10
# Process metrics (latency histograms, pool shape) on their own port, with no
# key. Keep it off the public interface; unset it to serve none.
GATEWAY_METRICS_BIND_ADDRESS=127.0.0.1:9464

RUST_LOG=gateway_worker=info,gateway_scheduler=info
