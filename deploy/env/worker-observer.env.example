# worker-observer: reads one chain source and records what it saw. One
# observer service per source; this one speaks as the source named below and
# connects as that source's own login role (see db/roles/20_*.template).

GATEWAY_WORKER_ROLES=observer
GATEWAY_DATABASE_URL=postgres://gateway_observer_trongrid_mainnet:CHANGE_ME@db.example.internal:5432/gateway?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
GATEWAY_INSTANCE_NAME=worker-observer-trongrid

GATEWAY_CHAIN=tron
GATEWAY_NETWORK=mainnet
GATEWAY_CHAIN_ENVIRONMENT=mainnet
GATEWAY_EXPECTED_COLLECTORS=TCollectorAddressBase58CHANGE_ME
GATEWAY_EXPECTED_ASSETS=tron:mainnet:TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# The chain_sources row this process is.
GATEWAY_OBSERVER_SOURCE_KEY=trongrid-mainnet
GATEWAY_TRON_BASE_URL=https://api.trongrid.io
GATEWAY_TRON_API_KEY=CHANGE_ME
GATEWAY_TRON_API_KEY_HEADER=TRON-PRO-API-KEY
GATEWAY_TRON_REQUEST_TIMEOUT_SECONDS=15
# block_range walks solidified blocks under a durable cursor; address_index
# asks the provider which transactions touched a collector.
GATEWAY_TRON_LANE=block_range
GATEWAY_TRON_MAX_BLOCKS_PER_SCAN=50
GATEWAY_TRON_BOOTSTRAP_LOOKBACK_BLOCKS=1200

GATEWAY_OBSERVER_INTERVAL_SECONDS=5
GATEWAY_OBSERVER_BATCH_LIMIT=200
GATEWAY_OBSERVER_MAX_BATCHES_PER_TICK=5

RUST_LOG=gateway_worker=info,gateway_scheduler=info,gateway_tron=info
