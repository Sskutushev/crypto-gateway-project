# worker-outbox: delivers signed webhooks from the transactional outbox. The
# only service that reaches merchant endpoints.

GATEWAY_WORKER_ROLES=outbox
GATEWAY_DATABASE_URL=postgres://gateway_payment_prod:CHANGE_ME@db.example.internal:5432/gateway?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
GATEWAY_INSTANCE_NAME=worker-outbox

GATEWAY_CHAIN=tron
GATEWAY_NETWORK=mainnet
GATEWAY_CHAIN_ENVIRONMENT=mainnet
GATEWAY_EXPECTED_COLLECTORS=TCollectorAddressBase58CHANGE_ME
GATEWAY_EXPECTED_ASSETS=tron:mainnet:TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# 32 or more random bytes, hex encoded: `openssl rand -hex 32`. Endpoint
# signing secrets are derived from it and never stored; rotating it means
# re-registering every endpoint's fingerprint.
GATEWAY_WEBHOOK_MASTER_KEY=CHANGE_ME_64_HEX_CHARACTERS
GATEWAY_WEBHOOK_REQUEST_TIMEOUT_SECONDS=10
GATEWAY_WEBHOOK_MAX_ATTEMPTS=12

GATEWAY_OUTBOX_INTERVAL_SECONDS=2
GATEWAY_OUTBOX_BATCH_LIMIT=100
GATEWAY_OUTBOX_MAX_BATCHES_PER_TICK=5

RUST_LOG=gateway_worker=info,gateway_scheduler=info,gateway_webhook=info
