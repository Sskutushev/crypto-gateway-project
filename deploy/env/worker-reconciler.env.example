# worker-reconciler: checks that the money still adds up and closes a rail
# when it does not. It reads everything and writes only its findings.

GATEWAY_WORKER_ROLES=reconciler
GATEWAY_DATABASE_URL=postgres://gateway_reconciler_prod:CHANGE_ME@db.example.internal:5432/gateway?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
GATEWAY_INSTANCE_NAME=worker-reconciler

GATEWAY_CHAIN=tron
GATEWAY_NETWORK=mainnet
GATEWAY_CHAIN_ENVIRONMENT=mainnet
GATEWAY_EXPECTED_COLLECTORS=TCollectorAddressBase58CHANGE_ME
GATEWAY_EXPECTED_ASSETS=tron:mainnet:TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

GATEWAY_RECONCILER_INTERVAL_SECONDS=300
GATEWAY_RECONCILER_BATCH_LIMIT=1
GATEWAY_RECONCILER_MAX_BATCHES_PER_TICK=1

RUST_LOG=gateway_worker=info,gateway_scheduler=info
